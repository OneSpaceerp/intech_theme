   "description": "Shown wherever the platform would name itself: page titles, the login page, emails, the About dialog."
  },
  {
   "fieldname": "brand_name_ar",
   "fieldtype": "Data",
   "label": "Brand Name (Arabic)",
   "description": "Used when the interface language is Arabic. Leave empty to keep the Latin name."
  },
  {
   "fieldname": "tagline",
   "fieldtype": "Data",
   "label": "Tagline",
